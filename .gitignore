# Nested source working trees and local bare repositories have their own Git history.
/source/
/private-repos/

# Secrets and operational data must not enter the management repository.
/private-config/
/database-backups/
/private-assets/backups/
/private-assets/migration/
**/.env
**/.env.*
!**/.env.example
*.sql
*.sql.gz
xboard-custom-test.tar.gz

# Local runtime and editor artifacts.
*.log
*.tmp
Thumbs.db
.DS_Store
.idea/
.vscode/

# Large or private binaries stay local.
/private-assets/xboard-node/go-vendor-*.zip
/private-assets/xboard-node/orphan-builds/
/private-assets/xboard/releases/
